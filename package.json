{
  "name": "mobile-heat-safety-tracker",
  "version": "1.0.0",
  "description": "Cross-platform mobile-native React Native application for recording heat safety checklists during sports practices",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "start:web": "expo start --web",
    "start:windows": "expo start --windows",
    "start:clear": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "windows": "expo start --windows",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:component": "jest --testPathPattern=tests/component",
    "test:e2e": "detox test",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "expo build",
    "build:android": "expo build --android",
    "build:ios": "expo build --ios",
    "build:web": "expo export -p web",
    "build:windows": "expo build --windows",
    "build:debug": "expo build --debug",
    "build:profile": "expo build --profile",
    "build:production": "expo build --profile production",
    "clean": "rm -rf node_modules && npm install",
    "clean:cache": "expo start --clear && npm run clean",
    "dev": "npm start",
    "dev:android": "npm run start:android",
    "dev:ios": "npm run start:ios",
    "dev:web": "npm run start:web",
    "dev:windows": "npm run start:windows",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "validate": "npm run lint && npm run typecheck && npm test",
    "setup": "npm install && npm run lint:fix && npm run format"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "expo-font": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.20",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.87.1",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^12.4.5",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "detox": "^20.13.0",
    "eslint": "^8.56.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^15.2.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.1",
    "react-devtools": "^4.13.7",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/*.stories.{ts,tsx}",
      "!src/**/*.e2e.{ts,tsx}"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/build/",
      "/dist/",
      "/e2e/"
    ],
    "modulePathIgnorePatterns": [
      "/build/",
      "/dist/"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "private": true
}
