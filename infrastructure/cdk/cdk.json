{
  "app": "npx ts-node --prefer-ts-exts bin/infrastructure.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "node_modules",
      "dist"
    ]
  },
  "context": {
    "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId": true,
    "@aws-cdk/core:stackRelativeExports": true,
    "@aws-cdk/aws-rds:_lowercaseDbUsername": true,
    "@aws-cdk/aws-lambda:recognizeVersionProps": true,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/aws-stepfunctions-tasks:enableEmotionlessEnvironmentVariables": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-codepipeline:crossRegionKeyAliases": true,
    "@aws-cdk/core:includePrefixInUniqueNameGeneration": true,
    "@aws-cdk/aws-efs:defaultEncryptionAtRest": true,
    "@aws-cdk/aws-s3:suppressCorrelationIds": true,
    "@aws-cdk/aws-lambda:createNewPoliciesWithAddToRolePolicy": true,
    "@aws-cdk/aws-iam:standardizedServicePrincipal": true,
    "@aws-cdk/aws-stepfunctions:useEnvironmentVariablesForCredentials": true,
    "@aws-cdk/core:targetPartition": "",
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/aws-lambda:enforceVersionAndAlias": false,
    "@aws-cdk/aws-glue:arbCamelCasing": true
  }
}
